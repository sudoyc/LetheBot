{
  "name": "lethebot",
  "version": "0.1.0",
  "description": "A persistent, local-first chatbot with thick memory layer and Pi-based reasoning core",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lethebot-cli": "dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:env": "node --env-file=.env --import tsx --watch src/index.ts",
    "start": "node dist/index.js",
    "start:env": "node --env-file=.env dist/index.js",
    "ci:check": "pnpm typecheck && pnpm typecheck:test && pnpm lint && pnpm build && pnpm release:preflight && pnpm release:pack-check && pnpm smoke && pnpm test:coverage && git diff --check",
    "build": "tsc && node dist/scripts/copy-governance-browser-assets.js",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint src tests scripts --ext .ts && eslint src/http/governance-browser-assets/*.js",
    "lint:fix": "eslint src tests scripts --ext .ts --fix && eslint src/http/governance-browser-assets/*.js --fix",
    "release:preflight": "tsx src/scripts/release-preflight.ts",
    "release:pack-check": "tsx src/scripts/release-pack-check.ts",
    "release:check": "pnpm typecheck && pnpm typecheck:test && pnpm lint && pnpm build && pnpm release:preflight && pnpm release:pack-check && pnpm test:run && git diff --check",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "LETHEBOT_SUBPROCESS_COVERAGE=1 vitest run --coverage && pnpm test:coverage:subprocess",
    "test:coverage:subprocess": "tsx scripts/check-subprocess-coverage.ts",
    "test:ui": "vitest --ui",
    "smoke": "tsx scripts/smoke-test.ts",
    "cli": "tsx src/cli/main.ts",
    "deploy:configure": "tsx src/scripts/deploy-napcat.ts --mode=configure",
    "deploy:docker": "tsx src/scripts/deploy-napcat.ts --mode=docker",
    "deploy:systemd": "tsx src/scripts/deploy-napcat.ts --mode=systemd",
    "deploy:pm2": "tsx src/scripts/deploy-napcat.ts --mode=pm2",
    "verify:onebot": "tsx src/scripts/verify-napcat.ts",
    "verify:napcat": "tsx src/scripts/verify-napcat.ts",
    "acceptance:evidence-template": "tsx src/scripts/local-acceptance-evidence.ts",
    "acceptance:db-summary": "tsx src/scripts/local-acceptance-evidence.ts --summarize-db",
    "acceptance:validate-evidence": "tsx src/scripts/local-acceptance-evidence.ts --validate",
    "ops:backup": "tsx src/scripts/ops-maintenance.ts backup",
    "ops:restore": "tsx src/scripts/ops-maintenance.ts restore",
    "ops:retention": "tsx src/scripts/ops-maintenance.ts retention",
    "ops:metrics": "tsx src/scripts/ops-maintenance.ts metrics",
    "ops:doctor": "tsx src/scripts/ops-maintenance.ts doctor",
    "ops:rehearse-maintenance": "tsx src/scripts/ops-maintenance.ts rehearse-maintenance",
    "ops:rehearse-rollback": "tsx src/scripts/ops-maintenance.ts rehearse-rollback",
    "ops:activate-release": "tsx src/scripts/application-release.ts activate",
    "ops:confirm-release": "tsx src/scripts/application-release.ts confirm",
    "ops:recover-release": "tsx src/scripts/application-release.ts recover",
    "ops:rehearse-application-rollback": "tsx src/scripts/application-release.ts rehearse",
    "ops:rehearse-cross-version": "tsx src/scripts/application-release.ts rehearse-cross-version",
    "ops:worker-soak": "tsx src/scripts/ops-maintenance.ts worker-soak"
  },
  "keywords": [
    "chatbot",
    "qq",
    "onebot",
    "memory",
    "ai",
    "pi"
  ],
  "author": "LetheBot contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudoyc/LetheBot.git"
  },
  "homepage": "https://github.com/sudoyc/LetheBot#readme",
  "bugs": {
    "url": "https://github.com/sudoyc/LetheBot/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@11.18.0",
  "lethebotSchema": {
    "contractVersion": 1,
    "targetVersion": 8,
    "minReadableVersion": 1,
    "maxReadableVersion": 8,
    "adoptsLegacyUnversioned": true
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.83.0",
    "@earendil-works/pi-ai": "^0.83.0",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "minimatch": "^10.2.6",
    "pino": "^10.3.1",
    "pino-pretty": "^13.0.0",
    "ulidx": "^2.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "c8": "^12.0.0",
    "eslint": "^10.8.0",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
