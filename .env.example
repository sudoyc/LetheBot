# LetheBot Configuration Example
# Copy to .env and fill in values. Do not commit .env.
# LetheBot does not auto-load this file. Pass it explicitly with
# `node --env-file=.env ...` or configure it in the process manager.

# Log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Test mode uses the in-process mock Pi runtime and rule-driven evaluator stub.
# It disables external Pi and evaluator calls.
LETHEBOT_TEST=false

# Background summaries read retained conversation text and may send it to the
# configured Pi provider. Keep disabled unless that exposure is authorized.
LETHEBOT_BACKGROUND_SUMMARY_ENABLED=false

# Database path
LETHEBOT_DB_PATH=./data/lethebot.db

# Optional absolute existing directory exposed to private owner/admin turns by
# bounded read-only workspace.list/read_text tools. Leave unset to omit both.
# LETHEBOT_WORKSPACE_ROOT=/absolute/path/to/workspace

# Optional comma-separated exact HTTPS origins for private owner/admin
# web.fetch_text. Leave unset or empty to omit the tool. Wildcards and paths are
# invalid; each request still requires evaluator approval.
# LETHEBOT_WEB_FETCH_ALLOWED_ORIGINS=https://docs.example.com,https://api.example.com:8443

# Optional comma-separated canonical reviewed tool names to disable at startup.
# Changes are restart-scoped; disabled tools remain inspectable but are not
# exposed to Pi or executable. Unknown names and duplicates fail startup.
# LETHEBOT_DISABLED_TOOLS=memory.search,runtime.tools

# Numeric runtime identity used by Docker Compose bind mounts. Pre-create the
# host data directory with this owner; the image defaults to node (1000:1000).
LETHEBOT_UID=1000
LETHEBOT_GID=1000

# Retention policy (days, 0 = forever). The compatibility memory variable
# covers rejected, disabled, and deleted memory records.
LETHEBOT_RAW_EVENT_RETENTION_DAYS=90
LETHEBOT_CHAT_MESSAGE_RETENTION_DAYS=90
LETHEBOT_AUDIT_LOG_RETENTION_DAYS=365
LETHEBOT_DISABLED_DELETED_MEMORY_RETENTION_DAYS=90
LETHEBOT_EVENT_PROCESSING_FAILURE_RETENTION_DAYS=90

# Pi runtime configuration used by src/index.ts
# Set PI_PROVIDER=mock for local dry runs, or configure a real provider/model.
PI_PROVIDER=mock
PI_MODEL=mock
PI_TURN_TIMEOUT_MS=120000
# Maximum active admitted conversational workflows (1..16, default 2).
PI_MAX_CONCURRENT_TURNS=2
# Maximum queued conversational workflows (0..128, default 128).
PI_MAX_QUEUED_TURNS=128
# PI_BASE_URL=https://api.deepseek.com/v1
# PI_API_KEY=

# Structured evaluator configuration.
# With EVALUATOR_PROVIDER and EVALUATOR_MODEL unset, social/tool evaluation
# inherits the complete PI provider/model/base/key identity above. If either
# identity field is set, set both and provide a separate evaluator key.
EVALUATOR_TIMEOUT_MS=30000
EVALUATOR_MAX_RETRIES=1
EVALUATOR_TEMPERATURE=0
EVALUATOR_PROMPT_VERSION=lethebot-governance-v1
# EVALUATOR_PROVIDER=openai
# EVALUATOR_MODEL=deepseek-chat
# EVALUATOR_BASE_URL=https://api.deepseek.com/v1
# EVALUATOR_API_KEY=

# SnowLuma / OneBot transport.
# ws is the default production path and does not expose the reverse HTTP event
# route. http enables that route for reverse HTTP compatibility.
ONEBOT_TRANSPORT=ws
ONEBOT_WS_URL=ws://localhost:3001/
ONEBOT_HTTP_URL=http://localhost:3000
# In ws mode, set this to literal true only when reverse HTTP ingress is also
# required. Values other than literal true/false fail configuration validation.
LETHEBOT_REVERSE_HTTP_ENABLED=false
# When reverse HTTP ingress is enabled and a token is set, incoming events use:
# Authorization: Bearer <ONEBOT_TOKEN>
# or SnowLuma X-Signature: sha1=<hmac-sha1(rawBody, ONEBOT_TOKEN)>.
# The same token is used for outgoing OneBot HTTP/WS API calls.
# Enabled reverse HTTP ingress on a non-loopback LETHEBOT_HOST requires a
# non-empty token.
ONEBOT_TOKEN=

# Bot QQ id used for exact CQ @ mention detection in group chats.
LETHEBOT_BOT_QQ_ID=

# Optional bot-owner QQ id used only for governance authority. This is distinct
# from the bot account id above and must be a raw 5-12 digit QQ id.
# LETHEBOT_BOT_OWNER_QQ_ID=123456789

# LetheBot HTTP Server Configuration
LETHEBOT_PORT=6700
LETHEBOT_HOST=127.0.0.1
LETHEBOT_HEALTH_PATH=/healthz
LETHEBOT_READINESS_PATH=/readyz
LETHEBOT_METRICS_PATH=/metrics
LETHEBOT_EVENT_PATH=/onebot/event
# Enabled reverse HTTP event requests are bounded by raw bytes and total body
# receive time. Both values must be positive integers.
LETHEBOT_MAX_EVENT_BODY_BYTES=262144
LETHEBOT_EVENT_BODY_TIMEOUT_MS=5000

# Optional local governance HTTP listener. It is disabled by default, accepts
# exact loopback hosts only, and uses an admin token independent of QQ roles.
# The governance port must differ from LETHEBOT_PORT while enabled.
LETHEBOT_GOVERNANCE_ENABLED=false
LETHEBOT_GOVERNANCE_HOST=127.0.0.1
LETHEBOT_GOVERNANCE_PORT=6701
LETHEBOT_GOVERNANCE_SESSION_TTL_MS=900000
# Required only when enabled: 32-512 control-free UTF-8 bytes.
# LETHEBOT_GOVERNANCE_ADMIN_TOKEN=
